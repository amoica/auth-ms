// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_AUTH")
}

model User {
  id       Int          @id @default(autoincrement())
  email    String       @unique
  password String
  roleId   Int
  role     Role         @relation(fields: [roleId], references: [id])
  profile  UserProfile?
  createBy Int?
  estado   Boolean      @default(true)

  @@map("users")
}

model UserProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  user      User    @relation(fields: [userId], references: [id])
  firstName String?
  lastName  String?
  dni       String?
  phone     String?
  address   String?
  avatarUrl String?

  @@map("user_profiles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique // e.g. "articulos:create" or "articulos:module"
  description String?
  category    String // e.g. "Artículos", "Movimientos", etc.
  module      String? // opcional: para agrupar permisos en UI, no usado en lógica
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  MenuItem    MenuItem[]

  @@map("permissions")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Nuevo modelo para los items de menú dinámico
model MenuItem {
  id           Int        @id @default(autoincrement())
  label        String
  icon         String?
  route        String     
  order        Int
  section      String? // p.ej. 'Home', 'Gestión General', 'Gestión Entidades'
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int

  @@unique([route])
  @@map("menu_items")
}
